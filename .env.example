# Database
# Pooled runtime connection string from Neon
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLED-HOST.neon.tech/neondb?sslmode=require"
# Direct connection string from Neon for Prisma Migrate / CLI
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Local-only auth escape hatch for development when SMTP is unavailable.
# Keep this off anywhere you want to test real verification/reset emails.
DEV_AUTH_BYPASS="false"

# Auth email delivery (verification + password reset)
# Recommended provider: Resend SMTP with a verified subdomain like mail.hoosfinds.com
# Optional single-string SMTP URL alternative:
# EMAIL_SERVER="smtps://resend:re_xxxxxxxxx@smtp.resend.com:465"
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_SECURE="true"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="HoosFinds <auth@mail.hoosfinds.com>"

# UploadThing
UPLOADTHING_TOKEN=""

# Stripe Checkout
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""
