# Database
# Pooled runtime connection string from Neon
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLED-HOST.neon.tech/neondb?sslmode=require"
# Direct connection string from Neon for Prisma Migrate / CLI
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="YOUR_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
# Local-only auth escape hatch for development when SMTP is unavailable.
# Keep this off anywhere you want to test real verification/reset emails.
DEV_AUTH_BYPASS="false"

# Auth email delivery (verification + password reset)
# Use your provider's SMTP credentials in your real .env / Netlify env vars.
# Example providers: Resend, Postmark, SendGrid, Mailgun, etc.
# Optional single-string SMTP URL alternative:
# EMAIL_SERVER="smtps://YOUR_SMTP_USERNAME:YOUR_SMTP_PASSWORD@YOUR_SMTP_HOST:465"
EMAIL_SERVER_HOST="YOUR_SMTP_HOST"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_SECURE="true"
EMAIL_SERVER_USER="YOUR_SMTP_USERNAME"
EMAIL_SERVER_PASSWORD="YOUR_SMTP_PASSWORD"
EMAIL_FROM="HoosFinds <auth@your-verified-mail-domain.com>"

# UploadThing
UPLOADTHING_TOKEN="YOUR_UPLOADTHING_TOKEN"

# Stripe Checkout
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"
STRIPE_CONNECT_WEBHOOK_SECRET="YOUR_STRIPE_CONNECT_WEBHOOK_SECRET"