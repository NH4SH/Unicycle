generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Category {
  DORM
  TEXTBOOKS
  STREETWEAR
  TECH
  TICKETS
  MISC
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  WELL_LOVED
}

enum ListingStatus {
  ACTIVE
  PENDING_CONFIRMATION
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  CHECKOUT_CREATED
  PAID
  REFUND_PENDING
  REFUNDED
  EXPIRED
  FAILED
}

enum TransactionStatus {
  PENDING_CONFIRMATION
  ISSUE_REPORTED
  COMPLETED
  CANCELLED
}

enum HandoffStatus {
  PENDING_HANDOFF
  MEETUP_SCHEDULED
  HANDOFF_CONFIRMED
  RECEIVED
  ISSUE_REPORTED
  CANCELLED
}

enum TransactionIssueType {
  ITEM_NOT_RECEIVED
  ITEM_NOT_AS_DESCRIBED
  WRONG_ITEM
  DAMAGED_OR_POOR_CONDITION
  SELLER_NO_SHOW
  BUYER_NO_SHOW
  LAST_MINUTE_CANCELLATION
  OTHER
}

enum TransactionIssueStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ConversationReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum TrustEventType {
  PAID_CANCELLATION
  REFUND_ISSUED
  SELLER_NO_SHOW
  BUYER_NO_SHOW
  ISSUE_REPORTED
  CONVERSATION_REPORTED
  USER_BLOCKED
  RELIST_AFTER_FAILED_HANDOFF
  DUPLICATE_CHECKOUT_BLOCKED
}

enum UserRole {
  USER
  VERIFIED_SHOP
  ADMIN
}

enum SellerKind {
  STUDENT
  VERIFIED_SHOP
}

enum VerifiedSellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum ListingModerationStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

enum AdminAuditActionType {
  VERIFIED_SELLER_APPROVED
  VERIFIED_SELLER_REJECTED
  VERIFIED_SELLER_REVOKED
  USER_BANNED
  USER_UNBANNED
  LISTING_HIDDEN
  LISTING_REMOVED
  LISTING_RESTORED
}

model User {
  /// Public display name shown across the marketplace. Keep UVA email / local
  /// computing ID internal to auth and account recovery, not profile identity.
  id                       String     @id @default(cuid())
  name                     String?
  email                    String     @unique
  emailVerified            DateTime?
  passwordHash             String?
  image                    String?
  profileImageUrl          String?
  uvaStudentId             String?
  username                 String     @unique @default(cuid())
  usernameConfirmed        Boolean    @default(true)
  bio                      String?
  gradYear                 Int?
  favoritePickup           String?
  role                     UserRole   @default(USER)
  sellerKind               SellerKind @default(STUDENT)
  verifiedShopName         String?
  verifiedShopApprovedAt   DateTime?
  verifiedShopNeighborhood String?
  verifiedShopAddress      String?
  verifiedShopInstagram    String?
  verifiedShopWebsite      String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  accounts Account[]
  sessions Session[]

  listings  Listing[]
  favorites Favorite[]
  followers Follow[]   @relation("UserFollowers")
  following Follow[]   @relation("UserFollowing")

  buyerConvos  Conversation[] @relation("BuyerConversations")
  sellerConvos Conversation[] @relation("SellerConversations")

  messages                           Message[]
  reports                            Report[]                    @relation("ReporterReports")
  waitlistEntries                    WaitlistEntry[]
  buyerOrders                        Order[]                     @relation("BuyerOrders")
  sellerOrders                       Order[]                     @relation("SellerOrders")
  buyerTransactions                  Transaction[]               @relation("BuyerTransactions")
  sellerTransactions                 Transaction[]               @relation("SellerTransactions")
  refundRequestedOrders              Order[]                     @relation("OrderRefundRequestedBy")
  purchasedListings                  Listing[]                   @relation("ListingSoldTo")
  writtenSellerReviews               SellerReview[]              @relation("WrittenSellerReviews")
  receivedSellerReviews              SellerReview[]              @relation("ReceivedSellerReviews")
  connectedAccount                   ConnectedAccount?
  checkoutReservations               CheckoutReservation[]       @relation("CheckoutReservationBuyer")
  reportedTransactionIssues          TransactionIssue[]          @relation("TransactionIssueReporter")
  resolvedTransactionIssues          TransactionIssue[]          @relation("TransactionIssueResolvedBy")
  reportedConversationReports        ConversationReport[]        @relation("ConversationReportReporter")
  reviewedConversationReports        ConversationReport[]        @relation("ConversationReportReviewedBy")
  blocksInitiated                    UserBlock[]                 @relation("UserBlockBlocker")
  blocksReceived                     UserBlock[]                 @relation("UserBlockBlocked")
  trustEvents                        UserTrustEvent[]            @relation("UserTrustSubject")
  emailVerificationTokens            EmailVerificationToken[]
  passwordResetTokens                PasswordResetToken[]
  connectProducts                    ConnectProduct[]            @relation("ConnectProductOwner")
  connectBuyerOrders                 ConnectOrder[]              @relation("ConnectBuyerOrders")
  connectSellerOrders                ConnectOrder[]              @relation("ConnectSellerOrders")
  reviewedVerifiedSellerApplications VerifiedSellerApplication[] @relation("VerifiedSellerApplicationReviewedBy")
  approvedVerifiedSellerApplication  VerifiedSellerApplication?  @relation("VerifiedSellerApplicationApprovedUser")
  bans                               UserBan[]                   @relation("BannedUser")
  issuedUserBans                     UserBan[]                   @relation("UserBanIssuedBy")
  revokedUserBans                    UserBan[]                   @relation("UserBanRevokedBy")
  moderatedListings                  Listing[]                   @relation("ListingModeratedBy")
  adminAuditLogs                     AdminAuditLog[]             @relation("AdminActionActor")
  adminTargetUserLogs                AdminAuditLog[]             @relation("AdminActionUserTarget")

  @@index([username])
  @@index([createdAt])
  @@index([role])
  @@index([sellerKind])
}

model Listing {
  id               String                  @id @default(cuid())
  title            String
  description      String
  priceCents       Int
  category         Category
  condition        Condition
  images           Json
  pickupLocations  Json
  meetupNotes      String?
  status           ListingStatus           @default(ACTIVE)
  moderationStatus ListingModerationStatus @default(VISIBLE)
  moderationReason String?
  moderatedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  sellerId      String
  seller        User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  soldToUserId  String?
  soldToUser    User?   @relation("ListingSoldTo", fields: [soldToUserId], references: [id], onDelete: SetNull)
  moderatedById String?
  moderatedBy   User?   @relation("ListingModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)

  favorites           Favorite[]
  conversations       Conversation[]
  reports             Report[]
  orders              Order[]
  checkoutReservation CheckoutReservation?
  transactions        Transaction[]
  trustEvents         UserTrustEvent[]
  adminAuditLogs      AdminAuditLog[]      @relation("AdminActionListingTarget")

  @@index([createdAt])
  @@index([category])
  @@index([status])
  @@index([sellerId])
  @@index([moderationStatus])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  buyerId   String
  sellerId  String
  listingId String
  createdAt DateTime @default(now())

  buyer        User                 @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller       User                 @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  listing      Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  messages     Message[]
  transactions Transaction[]
  reports      ConversationReport[]

  @@unique([buyerId, sellerId, listingId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Report {
  id         String   @id @default(cuid())
  listingId  String
  reporterId String
  reason     String
  createdAt  DateTime @default(now())

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter User    @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Order {
  id                      String      @id @default(cuid())
  listingId               String
  buyerId                 String
  sellerId                String
  /// Canonical merchandise price. Buyer totals and payout math live in the
  /// explicit breakdown fields below so checkout and reconciliation stay clear.
  amountCents             Int
  buyerPercentFeeCents    Int         @default(0)
  buyerFlatFeeCents       Int         @default(0)
  buyerFeeTotalCents      Int         @default(0)
  taxAmountCents          Int         @default(0)
  taxRateBps              Int         @default(0)
  buyerTotalCents         Int         @default(0)
  sellerFeeCents          Int         @default(0)
  stripeFeeCents          Int         @default(0)
  perOrderFeeCents        Int         @default(0)
  sellerPayoutCents       Int         @default(0)
  applicationFeeCents     Int         @default(0)
  status                  OrderStatus @default(CHECKOUT_CREATED)
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?     @unique
  stripeRefundId          String?     @unique
  checkoutExpiresAt       DateTime?
  paidAt                  DateTime?
  refundedAt              DateTime?
  refundReason            String?
  refundFailureReason     String?
  refundRequestedById     String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  listing             Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer               User                 @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller              User                 @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  refundRequestedBy   User?                @relation("OrderRefundRequestedBy", fields: [refundRequestedById], references: [id], onDelete: SetNull)
  checkoutReservation CheckoutReservation?
  transaction         Transaction?
  trustEvents         UserTrustEvent[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([refundRequestedById])
  @@index([status])
}

model Transaction {
  id                       String            @id @default(cuid())
  listingId                String
  sellerId                 String
  buyerId                  String
  conversationId           String?
  orderId                  String?           @unique
  status                   TransactionStatus @default(PENDING_CONFIRMATION)
  handoffStatus            HandoffStatus     @default(PENDING_HANDOFF)
  agreedPriceCents         Int?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  confirmedAt              DateTime?
  sellerMarkedSoldAt       DateTime?
  meetupLocation           String?
  meetupPlan               String?
  meetupScheduledAt        DateTime?
  meetupScheduledFor       DateTime?
  handoffConfirmedAt       DateTime?
  buyerConfirmedReceivedAt DateTime?

  listing      Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller       User               @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer        User               @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  order        Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  review       SellerReview?
  issues       TransactionIssue[]
  trustEvents  UserTrustEvent[]

  @@index([listingId])
  @@index([sellerId])
  @@index([buyerId])
  @@index([conversationId])
  @@index([status])
  @@index([handoffStatus])
  @@index([createdAt])
}

model SellerReview {
  id            String   @id @default(cuid())
  transactionId String   @unique
  reviewerId    String
  revieweeId    String
  stars         Int
  comment       String?
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("WrittenSellerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    User        @relation("ReceivedSellerReviews", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@index([revieweeId, createdAt])
  @@index([reviewerId, createdAt])
}

enum ConnectedAccountStatus {
  ACTIVE
  REQUIRES_RECONNECT
}

model ConnectedAccount {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  stripeAccountId String                 @unique
  status          ConnectedAccountStatus @default(ACTIVE)
  statusReason    String?
  disconnectedAt  DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  /// Stripe Connect sits underneath marketplace listings and only tracks where
  /// HoosFinds should route seller payouts.
  /// ACTIVE means the Stripe account ID is still usable and Stripe may simply
  /// need more onboarding details. REQUIRES_RECONNECT means the stored Stripe
  /// account ID is stale, closed, or inaccessible and the seller must create a
  /// fresh connection instead of reopening verification on the old one.
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  products ConnectProduct[]
  orders   ConnectOrder[]

  @@index([createdAt])
}

model CheckoutReservation {
  id                      String   @id @default(cuid())
  listingId               String   @unique
  buyerId                 String
  orderId                 String   @unique
  stripeCheckoutSessionId String?  @unique
  expiresAt               DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User    @relation("CheckoutReservationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([expiresAt])
}

model StripeWebhookEvent {
  id                  String    @id @default(cuid())
  stripeEventId       String    @unique
  eventType           String
  payload             Json?
  createdAt           DateTime  @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  lastError           String?

  @@index([eventType, createdAt])
  @@index([processingStartedAt])
  @@index([processedAt])
}

model TransactionIssue {
  id              String                 @id @default(cuid())
  transactionId   String
  reporterId      String
  resolvedById    String?
  issueType       TransactionIssueType
  description     String?
  status          TransactionIssueStatus @default(OPEN)
  resolutionNotes String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  resolvedAt      DateTime?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reporter    User        @relation("TransactionIssueReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy  User?       @relation("TransactionIssueResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([transactionId, status, createdAt])
  @@index([reporterId, createdAt])
  @@index([issueType, createdAt])
}

model ConversationReport {
  id             String                   @id @default(cuid())
  conversationId String
  reporterId     String
  reviewedById   String?
  reason         String
  status         ConversationReportStatus @default(OPEN)
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  reviewedAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter     User         @relation("ConversationReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ConversationReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model UserBlock {
  blockerUserId String
  blockedUserId String
  reason        String?
  createdAt     DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId])
  @@index([createdAt])
}

model UserTrustEvent {
  id            String         @id @default(cuid())
  userId        String
  type          TrustEventType
  description   String?
  metadata      Json?
  orderId       String?
  transactionId String?
  listingId     String?
  createdAt     DateTime       @default(now())

  user        User         @relation("UserTrustSubject", fields: [userId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  listing     Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([userId, type, createdAt])
  @@index([createdAt])
}

/// Legacy Connect storefront inventory. HoosFinds now uses Listing as the only
/// seller-facing inventory model and keeps this model only for migration
/// compatibility while old data is retired.
model ConnectProduct {
  id                 String   @id @default(cuid())
  ownerUserId        String
  connectedAccountId String
  stripeProductId    String   @unique
  stripePriceId      String   @unique
  name               String
  description        String?
  imageUrl           String?
  priceCents         Int
  currency           String   @default("usd")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner            User             @relation("ConnectProductOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  orders           ConnectOrder[]

  @@index([ownerUserId, createdAt])
  @@index([connectedAccountId, createdAt])
  @@index([active, createdAt])
}

/// Legacy Connect storefront orders retained temporarily so older records stay
/// queryable during the migration to listing-backed checkout.
model ConnectOrder {
  id                      String      @id @default(cuid())
  connectProductId        String
  buyerId                 String
  sellerId                String
  connectedAccountId      String
  amountCents             Int
  applicationFeeCents     Int
  status                  OrderStatus @default(CHECKOUT_CREATED)
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?     @unique
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  connectProduct   ConnectProduct   @relation(fields: [connectProductId], references: [id], onDelete: Cascade)
  buyer            User             @relation("ConnectBuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller           User             @relation("ConnectSellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([connectProductId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([connectedAccountId])
  @@index([status])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String
  reason    String
  createdAt DateTime @default(now())
  userId    String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model VerifiedSellerApplication {
  id             String                          @id @default(cuid())
  businessName   String
  contactName    String
  email          String                          @unique
  phone          String
  instagram      String
  website        String?
  neighborhood   String
  address        String
  whatTheySell   String
  description    String
  whyJoin        String
  status         VerifiedSellerApplicationStatus @default(PENDING)
  internalNotes  String?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  reviewedAt     DateTime?
  approvedAt     DateTime?
  reviewedById   String?
  approvedUserId String?                         @unique

  reviewedBy     User?           @relation("VerifiedSellerApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedUser   User?           @relation("VerifiedSellerApplicationApprovedUser", fields: [approvedUserId], references: [id], onDelete: SetNull)
  adminAuditLogs AdminAuditLog[] @relation("AdminActionVerifiedSellerTarget")

  @@index([status, createdAt])
  @@index([reviewedById, reviewedAt])
}

model UserBan {
  id            String    @id @default(cuid())
  userId        String
  reason        String
  internalNotes String?
  startsAt      DateTime  @default(now())
  endsAt        DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String
  revokedById   String?

  user      User  @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User  @relation("UserBanIssuedBy", fields: [createdById], references: [id], onDelete: Cascade)
  revokedBy User? @relation("UserBanRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, endsAt])
  @@index([createdAt])
}

model AdminAuditLog {
  id                                String               @id @default(cuid())
  action                            AdminAuditActionType
  reason                            String?
  notes                             String?
  metadata                          Json?
  createdAt                         DateTime             @default(now())
  actorId                           String
  targetUserId                      String?
  targetListingId                   String?
  targetVerifiedSellerApplicationId String?

  actor                           User                       @relation("AdminActionActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUser                      User?                      @relation("AdminActionUserTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetListing                   Listing?                   @relation("AdminActionListingTarget", fields: [targetListingId], references: [id], onDelete: SetNull)
  targetVerifiedSellerApplication VerifiedSellerApplication? @relation("AdminActionVerifiedSellerTarget", fields: [targetVerifiedSellerApplicationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetListingId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  /// Legacy NextAuth table kept because the Prisma adapter still expects the
  /// model shape even though HoosFinds no longer uses magic-link login.
  @@unique([identifier, token])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([email, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([email, expiresAt])
}
